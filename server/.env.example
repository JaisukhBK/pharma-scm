# SupplyFlow Server — Environment Variables
# Copy this to .env and fill in your values

# Neon PostgreSQL connection string (from console.neon.tech → your project → Connection Details)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# xAI Grok API Key (from console.x.ai)
XAI_API_KEY=xai-your-grok-api-key-here

# JWT secret for auth tokens (pick any random long string)
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# Client URL for CORS
CLIENT_URL=http://localhost:5173
